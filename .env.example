# Copy to .env (git-ignored) for local runs. GitHub Actions uses repo Secrets instead.
GEMINI_API_KEY=
APIFY_TOKEN=
# Optional: base64 of a Netscape cookies.txt for yt-dlp (use a throwaway IG account).
IG_COOKIES_B64=
# Optional: only needed for local non-dry-run issue updates if "gh auth login" is not set up.
# GITHUB_TOKEN=
